# Variables de compilación / entorno para CotiApp.
# Preferido en Flutter: `--dart-define=CLAVE=valor` (no commits de secretos).

# Enlace público de Stripe Payment Link (no es secreto de API). Respaldo si Functions no está desplegado.
STRIPE_PAYMENT_LINK=

# URL base de Cloud Functions (sin barra final).
# Ejemplo: https://us-central1-cotiapp-saas-jb.cloudfunctions.net
FUNCTIONS_BASE_URL=

# URLs opcionales de documentos legales externos
PRIVACY_URL=
TERMS_URL=

# Correo de soporte mostrado en la UI
SUPPORT_EMAIL=

# No colocar aquí:
# - Service account JSON de Firebase
# - Claves secretas de Stripe (sk_ / whsec_)
# - Keystores ni contraseñas de firma
# - Tokens de CI
#
# Secretos de Functions (fuera de Git):
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
#   firebase functions:secrets:set STRIPE_PRICE_PRO
#
# Ver docs/BACKEND_STRIPE.md
